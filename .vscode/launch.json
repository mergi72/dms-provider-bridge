{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: dms-provider-bridge",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "dms_provider_bridge.app.server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8765"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    },
    {
      "name": "FastAPI: dms-provider-bridge (reload)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "dms_provider_bridge.app.server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8765",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    }
  ]
}

