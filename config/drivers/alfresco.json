{
    "projectInfo": {
        "name": "eDoCat Helper",
        "author": "DMS Provider Bridge contributors",
        "email": "",
        "version": "1.1.1",
        "description": "Alfresco Search configuration for eDoCat Helper",
        "license": "......"
    },

    "config.json": {
        "version": "1.1.1",
        "lastModified": "2025-12-22T09:30:00Z",
        "_comment": "Configuration for Alfresco Search API (used instead of eDoCat wrapper search)."
    },

    "_comment": "Unix/VFS mapping: alfresco.json = filesystem driver for Alfresco repositories. It maps TC VFS Contract operations to Alfresco REST API calls.",

    "key": "alfresco",

    "debug": {
        "enable": false,
        "path": "%APPDATA%\\DMS Provider\\logs"
    },

    "auth": {
        "mode": "windows",
        "authScheme": "ticket",
        "credential_id": "",
        "target": "",
        "targetBase": ""
    },

    "download": {
        "maxBase64Bytes": 314572800
    },

    "transfer": {
        "maxBase64Bytes": 314572800
    },

    "upload": {
        "inline": {
            "maxBytes": 314572800
        }
    },

    "alfresco": {
        "display_name": "Alfresco",
        "description": "Alfresco repository driver.",
        "tc_vfs_contract": "tc-vfs-contract",

        "base_url": "https://example.com/alfresco",

        "api": {
            "search_root": "/api/-default-/public/search/versions/1",
            "repo_root": "/api/-default-/public/alfresco/versions/1"
        },

        "doc_library": "/app:company_home/st:sites/cm:deals/cm:documentLibrary",

        "endpoints": {
            "search": "/search",
            "nodes": "/nodes",
            "people_me": "/people/-me-"
        },

        "search": {
            "language": "afts",

            "scope": {
                "document_library": "/cm:documentLibrary",
                "current_folder": "/*",
                "current_folder_tree": "//*"
            },

            "defaults": {
                "include": ["path", "properties"],
                "sort": {
                    "field": "cm:name",
                    "ascending": true
                },
                "paging": {
                    "maxItems": 200,
                    "skipCount": 0
                }
            }
        },

        "nodeType": {
            "file": [
                "cm:content",
                "ctbd:baseDoc"
            ],
            "folder": [
                "cm:folder",
                "ctfd:baseFolder"
            ],
            "all": [
                "cm:content",
                "cm:folder",
                "ctbd:baseDoc",
                "ctfd:baseFolder"
            ]
        },

        "capabilities": {
            "versioning": {
                "supported": true,
                "modes": ["version"],
                "existing_upload": "version_required",
                "majorVersion": false,
                "comment_supported": true
            },
            "shareUrl": {
                "supported": true
            },
            "folderDownload": {
                "supported": false
            },
            "stream": {
                "download": true,
                "upload": true,
                "copy": false
            }
        }
    }
}
