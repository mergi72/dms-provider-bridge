{
    "projectInfo": {
            "name": "eDoCat Helper",
            "author": "DMS Provider Bridge contributors",
            "email": "",
            "version": "0.0.2",
            "description": "......",
            "license": "......"
    },

    "config.json": {
        "version": "0.0.4",
        "lastModified": "2025-12-12T16:45:00Z",
        "_comment": "This file contains the configuration for the VBA project."
    },

    "_comment": "Unix/VFS mapping: edocat.json = filesystem driver for eDoCat repositories. It maps TC VFS Contract operations to eDoCat API calls and Alfresco fallback APIs when needed.",

    "key": "edocat",

    "debug": {
        "enable": false,
        "path": "%APPDATA%\\DMS Provider\\logs"
    },

    "auth": {
        "mode": "windows",
        "authScheme": "basic",
        "credential_id": "",
        "target": "",
        "targetBase": ""
    },

    "copy": {
        "maxNodes": 200
    },

    "transfer": {
        "maxBase64Bytes": 314572800,
        "maxNodes": 500
    },

    "upload": {
        "maxBase64Bytes": 314572800
    },

    "download": {
        "maxBase64Bytes": 314572800,
        "maxNodes": 500
    },

    "timeouts": {
        "requestSeconds": 60,
        "uploadSeconds": 300
    },

    "edocat": {
        "display_name": "eDoCat",
        "description": "eDoCat repository driver.",
        "tc_vfs_contract": "provider",

        "base_url": "https://example.com",
        "api": "/edocat/api/v1",
        "doc_library": "/deals",
        "endpoints": {
            "node": "/node",
            "query": "/node/query",
            "search": "/node/search",
            "tracker": "/node/tracker"
        },
        "nodeType":{
            "baseFolder": "com.onlio.edocat.BaseFolder",
            "baseDoc": "com.onlio.edocat.BaseDoc",
            "file": "com.onlio.edocat.File"
        },

        "capabilities": {
            "versioning": {
                "supported": true,
                "modes": ["version"],
                "existing_upload": "version_required",
                "majorVersion": false,
                "comment_supported": true
            },
            "shareUrl": {
                "supported": false
            },
            "folderDownload": {
                "supported": true
            },
            "stream": {
                "download": true,
                "upload": true,
                "copy": false
            }
        }
    }
}

