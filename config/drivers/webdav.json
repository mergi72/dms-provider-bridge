{
    "projectInfo": {
        "name": "WebDAV Driver",
        "author": "DMS Provider Bridge contributors",
        "email": "",
        "version": "0.9.10-beta",
        "description": "Generic WebDAV driver configuration.",
        "license": ""
    },

    "config.json": {
        "version": "0.9.10-beta",
        "lastModified": "",
        "_comment": "Generic WebDAV driver. Concrete server URL and mount values belong to connection config."
    },

    "_comment": "Unix/VFS mapping: webdav.json = generic filesystem driver for WebDAV endpoints. It maps TC VFS Contract operations to RFC 4918 WebDAV methods.",

    "debug": {
        "enable": false,
        "path": "%APPDATA%\\DMS Provider\\logs"
    },

    "key": "webdav",

    "webdav": {
        "display_name": "WebDAV",
        "description": "Generic WebDAV filesystem driver.",

        "tc_vfs_contract": "tc-vfs-contract",

        "api": {
            "base": "",
            "version": "RFC4918",
            "root": "",
            "search_root": "",
            "repo_root": ""
        },

        "webdav": {
            "resource_path": "",
            "path_encoding": "url",
            "directory_trailing_slash": true,
            "propfind": {
                "list_depth": "1",
                "stat_depth": "0",
                "properties": [
                    "displayname",
                    "resourcetype",
                    "getcontentlength",
                    "getcontenttype",
                    "getlastmodified",
                    "getetag",
                    "creationdate"
                ]
            },
            "overwrite": {
                "copy": false,
                "move": false,
                "upload": false
            }
        },

        "endpoints": {
            "health": "",
            "search": "",
            "nodes": "",
            "node": "",
            "query": "",
            "tracker": "",
            "people_me": "",
            "download": "",
            "upload": "",
            "copy": "",
            "move": "",
            "delete": "",
            "mkdir": ""
        },

        "methods": {
            "list": "PROPFIND",
            "stat": "PROPFIND",
            "download": "GET",
            "upload": "PUT",
            "copy": "COPY",
            "move": "MOVE",
            "delete": "DELETE",
            "mkdir": "MKCOL"
        },

        "search": {
            "language": "",

            "scope": {
                "document_library": "",
                "current_folder": "",
                "current_folder_tree": ""
            },

            "defaults": {
                "include": [],
                "sort": {
                    "field": "",
                    "ascending": true
                },
                "paging": {
                    "maxItems": 200,
                    "skipCount": 0
                }
            }
        },

        "nodeType": {
            "file": [],
            "folder": [],
            "all": [],
            "baseFolder": "",
            "baseDoc": ""
        },

        "capabilities": {
            "versioning": {
                "supported": false,
                "modes": [],
                "existing_upload": "",
                "majorVersion": false,
                "comment_supported": false
            },
            "shareUrl": {
                "supported": false
            },
            "folderDownload": {
                "supported": false
            },
            "stream": {
                "download": true,
                "upload": true,
                "copy": true
            }
        },

        "limits": {
            "timeouts": {
                "requestSeconds": 60,
                "downloadSeconds": 300,
                "uploadSeconds": 300
            },
            "copy": {
                "maxNodes": 500
            },
            "download": {
                "maxBase64Bytes": 314572800,
                "maxNodes": 500
            },
            "upload": {
                "maxBase64Bytes": 314572800,
                "inline": {
                    "maxBytes": 314572800
                },
                "raw": {
                    "chunkBytes": 1048576,
                    "maxBytes": 314572800
                }
            },
            "transfer": {
                "maxInlineBytes": 10485760,
                "maxBase64Bytes": 314572800,
                "maxNodes": 500,
                "preferStream": true,
                "tempFallback": true
            }
        }
    }
}
